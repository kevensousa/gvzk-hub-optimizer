<UserControl x:Class="GvzkHubOptimizer.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="880">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Quick Actions -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Otimizações e Ajustes do Windows" 
                       FontSize="26" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Ative ou desative ajustes com segurança. Todas as alterações são reversíveis." 
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       Margin="0,0,0,12" />

            <!-- Quick Action Bar -->
            <WrapPanel Margin="0,0,0,10">
                <ui:Button Content="🛡️  Criar Ponto de Restauração" 
                           Appearance="Primary" 
                           Click="OnCreateRestorePointClick"
                           Margin="0,0,8,6"/>

                <ui:Button Content="⚡  Plano Desempenho Máximo" 
                           Appearance="Secondary" 
                           Click="OnUltimatePowerClick"
                           Margin="0,0,8,6"/>

                <ui:Button Content="🚫  Retirar Transparência" 
                           Appearance="Secondary" 
                           Click="OnRemoveTransparencyClick"
                           Margin="0,0,8,6"/>

                <ui:Button Content="🚀  Visual Desempenho (Fontes/Miniaturas)" 
                           Appearance="Secondary" 
                           Click="OnOptimizedVisualsClick"
                           Margin="0,0,8,6"/>

                <ui:Button Content="📋  Restaurar Win + V" 
                           Appearance="Secondary"
                           Click="OnFixClipboardClick"
                           Margin="0,0,8,6"/>

                <ui:Button Content="🔄  Reiniciar Explorer" 
                           Appearance="Secondary"
                           Click="OnRestartExplorerClick"
                           Margin="0,0,8,6"/>
            </WrapPanel>
        </StackPanel>

        <!-- Modern Restart Alert / Guidance Card -->
        <Border Grid.Row="1" Background="#180078D4" BorderBrush="#4000b4d8" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="💡" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Guia de Aplicação dos Ajustes:" FontSize="13" FontWeight="Bold" Foreground="#00b4d8"/>
                    <TextBlock Text="• '🔄 Requer Reiniciar Explorer': entra em vigor ao clicar em 'Reiniciar Explorer' (sem fechar seus programas abertos)." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                    <TextBlock Text="• '💻 Requer Reiniciar PC': serviços do kernel, limites de rede e fax só são descarregados na reinicialização do Windows." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                    <TextBlock Text="• '⚡ Imediato': entra em vigor imediatamente após alternar o botão." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0"/>
                </StackPanel>

                <ui:Button Grid.Column="2" 
                           Content="🔄  Reiniciar Explorer Agora" 
                           Appearance="Primary" 
                           VerticalAlignment="Center"
                           Click="OnRestartExplorerClick"
                           Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Category Filters -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Todos" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Todos"/>
                <ui:Button Content="Produtividade" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Produtividade"/>
                <ui:Button Content="Sistema" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Sistema"/>
                <ui:Button Content="Privacidade" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Privacidade"/>
                <ui:Button Content="Aplicativos" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Aplicativos"/>
                <ui:Button Content="Jogos" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Jogos"/>
                <ui:Button Content="Windows Update" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Windows Update"/>
                <ui:Button Content="Extras" Margin="0,0,6,0" Click="OnCategoryClick" Tag="Extras"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Tweaks List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FilteredTweaks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        
                                        <!-- Categoria Badge -->
                                        <Border Background="#200078D4" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#0078D4" FontWeight="Medium"/>
                                        </Border>

                                        <!-- Restart Requirement Badge -->
                                        <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding RestartBadgeText}" FontSize="11" Foreground="{Binding RestartBadgeColor}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <ui:ToggleSwitch Grid.Column="1" 
                                                 IsChecked="{Binding IsActive, Mode=TwoWay}" 
                                                 VerticalAlignment="Center" 
                                                 Margin="12,0,0,0"
                                                 Click="OnTweakToggleClick"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Status -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="8,6" Background="#10FFFFFF" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
