<UserControl x:Class="GvzkHubOptimizer.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900">
            <!-- Header -->
            <TextBlock Text="Rede &amp; Velocidade" 
                       FontSize="26" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Meça a velocidade e latência da sua conexão e otimize seus servidores DNS." 
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       Margin="0,0,0,20" />

            <!-- Speed Test Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="📶" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Teste de Conexão, Download &amp; Upload" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <!-- Ping Box -->
                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="14" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="LATÊNCIA (PING)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PingDisplay}" FontSize="28" FontWeight="Bold" Foreground="#00b4d8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Download Box -->
                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="14" Margin="4,0,4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="DOWNLOAD REAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DownloadDisplay}" FontSize="28" FontWeight="Bold" Foreground="#2da44e" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Upload Box -->
                        <Border Background="#14FFFFFF" CornerRadius="6" Padding="14" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="UPLOAD REAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding UploadDisplay}" FontSize="28" FontWeight="Bold" Foreground="#9b5de5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ProgressBar IsIndeterminate="True" 
                                 Height="4"
                                 Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                 Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding TestStatus}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <ui:Button Grid.Column="1" 
                                   Content="▶️  Iniciar Teste de Velocidade" 
                                   Appearance="Primary" 
                                   IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}"
                                   Click="OnStartSpeedTestClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- DNS Optimization Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="🌐" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Otimizador de Servidor DNS" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Servidores DNS mais rápidos diminuem o tempo de resposta em jogos e navegação na web." 
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                    <ComboBox ItemsSource="{Binding DnsPresets}" 
                              SelectedItem="{Binding SelectedDns, Mode=TwoWay}" 
                              DisplayMemberPath="Name" 
                              FontSize="14" Padding="10,6" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding SelectedDns.Description}" FontSize="13" Foreground="#00b4d8" Margin="0,0,0,16"/>

                    <WrapPanel Margin="0,0,0,12">
                        <ui:Button Content="✓  Aplicar Servidor DNS Selecionado" 
                                   Appearance="Primary" 
                                   Click="OnApplyDnsClick"
                                   Margin="0,0,10,6"/>

                        <ui:Button Content="🔄  Limpar Cache de DNS (Flush DNS)" 
                                   Appearance="Secondary" 
                                   Click="OnFlushDnsClick"
                                   Margin="0,0,10,6"/>
                    </WrapPanel>

                    <Border Padding="8,6" Background="#10FFFFFF" CornerRadius="4">
                        <TextBlock Text="{Binding DnsStatus}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
