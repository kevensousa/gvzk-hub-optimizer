<UserControl x:Class="GvzkHubOptimizer.Views.UwpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Desinstalador UWP (Bloatwares do Windows)" 
                       FontSize="26" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Remova aplicativos nativos e patrocinados pré-instalados no Windows para aliviar o sistema." 
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       Margin="0,0,0,16" />

            <WrapPanel>
                <ui:Button Content="🔄  Escanear Aplicativos" 
                           Appearance="Secondary" 
                           Click="OnScanClick"
                           Margin="0,0,10,6"/>

                <ui:Button Content="🗑️  Desinstalar Selecionados" 
                           Appearance="Danger" 
                           Click="OnUninstallClick"
                           Margin="0,0,10,6"/>
            </WrapPanel>
        </StackPanel>

        <!-- Apps List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding PackageName}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="8,4" Background="#10FFFFFF" CornerRadius="4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
