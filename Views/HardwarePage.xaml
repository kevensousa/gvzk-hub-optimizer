<UserControl x:Class="GvzkHubOptimizer.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900">
            <!-- Header -->
            <TextBlock Text="Visão Geral do Hardware" 
                       FontSize="26" FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                       Margin="0,0,0,4" />
            <TextBlock Text="Especificações principais do computador detectadas pelo sistema." 
                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                       Margin="0,0,0,20" />

            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="True" 
                         Height="4"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                         Margin="0,0,0,16" />

            <!-- Main Specs Grid -->
            <UniformGrid Columns="2" Margin="0,0,0,16">
                <!-- Processador Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="💻" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Processador (CPU)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.CpuName}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Summary.CpuCoresThreads}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Summary.CpuBaseClock}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Summary.CpuBoostClock}" FontSize="13" Foreground="#00b4d8" Margin="0,2,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Placa de Vídeo Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🎮" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Placa de Vídeo (GPU)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.GpuName}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Summary.GpuVram}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Summary.GpuDriver}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Memória RAM Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🧠" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Memória RAM" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.RamTotal}" FontSize="15" FontWeight="Medium" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Summary.RamFrequency, StringFormat='Frequência: {0}'}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding Summary.RamModules}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Summary.RamLatency}" FontSize="12" Foreground="#2da44e" Margin="0,4,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Armazenamento Card -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="💾" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Unidades de Disco" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="6,4" Background="#14FFFFFF" CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Model}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MediaType}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FreeSpace}" FontSize="12" Foreground="#00b4d8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Botão Expandir Especificações Avançadas -->
            <ui:Button Content="🔍  Mostrar Mais Especificações Avançadas (Periféricos, Áudio, Placa-Mãe)" 
                       Click="OnToggleAdvancedClick"
                       HorizontalAlignment="Stretch"
                       Margin="0,12,0,16" />

            <!-- Painel de Especificações Avançadas (Expansível) -->
            <Border Visibility="{Binding IsAdvancedOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Especificações Avançadas e Dispositivos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Placa-Mãe e BIOS -->
                    <TextBlock Text="Placa-Mãe &amp; BIOS" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#0078D4"/>
                    <TextBlock Text="{Binding Summary.Motherboard.Manufacturer, StringFormat='Fabricante: {0}'}" FontSize="13"/>
                    <TextBlock Text="{Binding Summary.Motherboard.Product, StringFormat='Modelo: {0}'}" FontSize="13" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Summary.Bios.Version, StringFormat='Versão da BIOS: {0}'}" FontSize="13" Margin="0,2,0,0"/>
                    <Separator Margin="0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Dispositivos de Áudio -->
                    <TextBlock Text="Dispositivos de Áudio" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#107C41"/>
                    <ItemsControl ItemsSource="{Binding Summary.AudioDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="13" Margin="4,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,12" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Periféricos e Controladores USB -->
                    <TextBlock Text="Periféricos &amp; Dispositivos de Entrada (Gerenciador de Dispositivos)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#8764B8"/>
                    <ItemsControl ItemsSource="{Binding Summary.Peripherals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="13" Margin="4,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
