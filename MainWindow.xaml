<ui:FluentWindow x:Class="GvzkHubOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:GvzkHubOptimizer.Views"
        Title="gvzk HUB Optimizer" 
        Icon="pack://application:,,,/Assets/app.ico"
        Height="730" Width="1140"
        MinHeight="620" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="gvzk HUB Optimizer">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="v1.2.0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" 
                    BorderThickness="0,0,1,0" 
                    Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Header with Polished Logo -->
                    <Border Grid.Row="0" 
                            CornerRadius="10" 
                            Margin="0,0,0,18" 
                            Padding="8,10" 
                            Background="#032D3B" 
                            BorderBrush="#00b4d8" 
                            BorderThickness="1.5">
                        <Image Source="pack://application:,,,/Assets/logo_header.jpg" 
                               MaxHeight="90" 
                               Stretch="Uniform" 
                               HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavHardware" 
                                     Content="🖥️  Hardware (Início)" 
                                     IsChecked="True" 
                                     Style="{StaticResource DefaultRadioButtonStyle}"
                                     FontSize="14" Padding="12,10" Margin="0,0,0,6"
                                     Checked="OnNavChanged" Tag="Hardware"/>

                        <RadioButton x:Name="NavTweaks" 
                                     Content="⚡  Otimizações" 
                                     Style="{StaticResource DefaultRadioButtonStyle}"
                                     FontSize="14" Padding="12,10" Margin="0,0,0,6"
                                     Checked="OnNavChanged" Tag="Tweaks"/>

                        <RadioButton x:Name="NavCleaner" 
                                     Content="🧹  Limpeza" 
                                     Style="{StaticResource DefaultRadioButtonStyle}"
                                     FontSize="14" Padding="12,10" Margin="0,0,0,6"
                                     Checked="OnNavChanged" Tag="Cleaner"/>

                        <RadioButton x:Name="NavUwp" 
                                     Content="📦  Bloatwares (UWP)" 
                                     Style="{StaticResource DefaultRadioButtonStyle}"
                                     FontSize="14" Padding="12,10" Margin="0,0,0,6"
                                     Checked="OnNavChanged" Tag="Uwp"/>

                        <RadioButton x:Name="NavNetwork" 
                                     Content="🌐  Rede &amp; Velocidade" 
                                     Style="{StaticResource DefaultRadioButtonStyle}"
                                     FontSize="14" Padding="12,10" Margin="0,0,0,6"
                                     Checked="OnNavChanged" Tag="Network"/>
                    </StackPanel>

                    <!-- Footer Info -->
                    <Border Grid.Row="2" Padding="10,12" Background="#0affffff" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Status: Seguro &amp; Elevado" FontSize="12" FontWeight="SemiBold" Foreground="#2da44e"/>
                            <TextBlock Text="Ajustes com Rollback Ativo" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Column="1" x:Name="MainContent" Margin="0"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
